    "preflight": "./deploy/preflight.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "agent-substrate",
    "kagent-enterprise",
    "kubernetes",
    "ai-agents",
    "gvisor",
    "claude-code",
    "visualization"
  ],
  "author": "Mike Moore",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/themsquared/kagent-enterprise-substrate.git"
  }
}
